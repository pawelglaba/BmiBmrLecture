<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/burgundy">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/paper">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:focusableInTouchMode="true">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:textColor="@color/ink"
                android:text="@string/result_title"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/measurementsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/secondary"
                android:layout_marginTop="6dp"
                tools:text="70 kg · 175 cm · 25 years · Male equation" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/bmi_panel"
                android:padding="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/on_burgundy"
                    android:text="@string/bmi_label" />
                <TextView
                    android:id="@+id/bmiText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="34sp"
                    android:textColor="@color/on_burgundy"
                    android:layout_marginTop="4dp"
                    tools:text="22.9 kg/m²"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/categoryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/on_burgundy"
                    android:layout_marginTop="2dp"
                    tools:text="Healthy weight" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/panel"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/ink"
                    android:layout_marginBottom="6dp"
                    android:text="@string/scale_title"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/underweightRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/ink"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/range_underweight" />
                <TextView
                    android:id="@+id/healthyRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/ink"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/range_healthy" />
                <TextView
                    android:id="@+id/overweightRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/ink"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/range_overweight" />
                <TextView
                    android:id="@+id/obesityRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/ink"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/range_obesity" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/panel"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/secondary"
                    android:text="@string/energy_label" />
                <TextView
                    android:id="@+id/energyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    android:textColor="@color/ink"
                    android:layout_marginTop="2dp"
                    tools:text="1674 kcal/day"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_label"
                    android:layout_marginTop="16dp"
                    android:labelFor="@+id/activitySlider"
                    android:textColor="@color/ink" />
                <SeekBar
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/activitySlider"
                    android:max="10"
                    android:progress="5"
                    android:minHeight="48dp"
                    android:progressTint="@color/burgundy"
                    android:thumbTint="@color/burgundy" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/levelText"
                    android:textColor="@color/ink" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_hint"
                    android:textColor="@color/ink" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_label"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/ink" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/dailyText"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    android:textColor="@color/ink" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/secondary"
                android:layout_marginTop="14dp"
                android:text="@string/education_note" />
            <!-- Lecture: the editor starts hidden. Edit reveals the same four fields as the form. -->
            <Button
                android:id="@+id/editButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:layout_marginTop="16dp"
                android:text="@string/edit"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:backgroundTint="@color/burgundy"
                android:textColor="@color/on_burgundy" />
            <LinearLayout
                android:id="@+id/editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <include layout="@layout/measurement_fields" />
                <Button
                    android:id="@+id/recalculateButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/recalculate"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:backgroundTint="@color/burgundy"
                    android:textColor="@color/on_burgundy" />
                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/save"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:backgroundTint="@color/burgundy"
                    android:textColor="@color/on_burgundy" />
            </LinearLayout>
            <Button
                android:id="@+id/backButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:layout_marginTop="16dp"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:backgroundTint="@color/burgundy"
                android:textColor="@color/on_burgundy" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
