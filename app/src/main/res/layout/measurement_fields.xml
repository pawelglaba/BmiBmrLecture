<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="16dp"
    android:background="@drawable/panel"
    android:padding="16dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/ink"
        android:labelFor="@+id/weightInput"
        android:layout_marginTop="0dp"
        android:text="@string/weight_label"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/weightInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:inputType="numberDecimal"
        android:imeOptions="actionNext"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textColorHint="@color/secondary"
        android:backgroundTint="@color/burgundy"
        android:textSize="18sp"
        android:hint="@string/weight_hint" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/ink"
        android:labelFor="@+id/heightInput"
        android:layout_marginTop="12dp"
        android:text="@string/height_label"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/heightInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:inputType="numberDecimal"
        android:imeOptions="actionNext"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textColorHint="@color/secondary"
        android:backgroundTint="@color/burgundy"
        android:textSize="18sp"
        android:hint="@string/height_hint" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/ink"
        android:labelFor="@+id/ageInput"
        android:layout_marginTop="12dp"
        android:text="@string/age_label"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/ageInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:inputType="number"
        android:imeOptions="actionDone"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textColorHint="@color/secondary"
        android:backgroundTint="@color/burgundy"
        android:textSize="18sp"
        android:hint="@string/age_hint" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/ink"
        android:layout_marginTop="14dp"
        android:labelFor="@+id/sexGroup"
        android:text="@string/variant_label"
        android:textStyle="bold" />
    <RadioGroup
        android:id="@+id/sexGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RadioButton
            android:id="@+id/femaleOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:buttonTint="@color/burgundy"
            android:textSize="16sp"
            android:textColor="@color/ink"
            android:text="@string/female" />
        <RadioButton
            android:id="@+id/maleOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:buttonTint="@color/burgundy"
            android:textSize="16sp"
            android:textColor="@color/ink"
            android:text="@string/male" />
    </RadioGroup>
</LinearLayout>
